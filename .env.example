# AgarthaVision Admin Console — environment template
#
# Copy to .env.local and fill in from the Supabase project dashboard.
# .env.local is gitignored. Never commit a filled-in copy of this file.

# ── Provider selection (src/adapters/registry.ts) ────────────────────────────
# Only "supabase" is implemented in this pass. Any other value throws at startup.
DB_PROVIDER=supabase
STORAGE_PROVIDER=supabase
AUTH_PROVIDER=supabase

# ── Supabase ────────────────────────────────────────────────────────────────
# Browser-safe: project URL and anon key (RLS still applies).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: service role key. Never prefix with NEXT_PUBLIC_.
# Read only to make an invited person's account when they accept (auth.admin.createUser).
# Every read, image signing included, runs as the signed-in user.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket holding sample frames ({user_id}/{sample_id}.jpg).
SUPABASE_SAMPLES_BUCKET=samples

# Signed URL lifetime in seconds.
SUPABASE_SIGNED_URL_TTL_SECONDS=60

# ── Human check (src/components/auth/HumanCheck.tsx) ─────────────────────────
# Browser-safe: the Cloudflare Turnstile widget's SITE key, inlined at build time, so a change
# needs a redeploy. Blank: no widget, no token, which works only while Supabase's CAPTCHA
# protection is off. The widget's SECRET key never goes here; it belongs in Supabase →
# Authentication → Attack Protection. See docs/map/processes/human-check.md.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Console session limits (src/proxy.ts, 14zcqntnqpd) ─────────────────────────
# Server-only. Signs the last-activity cookie so it cannot be edited to stretch the idle
# limit: a random value of 32 characters or more, e.g. `openssl rand -base64 48`. Blank or
# shorter: the idle limit is off (the 12-hour limit still holds). Changing it ends every
# console session at its next request. See docs/map/processes/admin-gate.md.
CONSOLE_SESSION_SECRET=
# Optional. Hours from sign-in, and minutes without a request, before a console session ends.
# Defaults 12 and 60. The mobile app's sessions are never affected.
CONSOLE_SESSION_MAX_HOURS=
CONSOLE_SESSION_IDLE_MINUTES=

# ── Attempt limits (src/lib/attempt-limit.ts, 14zcqntnqp6) ────────────────────
# Optional. The request header holding the client's IP, for the limit of 20 failed sign-ins
# per IP in 15 minutes. Default `x-forwarded-for` (its first entry), which Vercel sets itself.
# On another host, name the header that host sets and a client cannot (e.g. `cf-connecting-ip`
# behind Cloudflare). If the header is missing, attempts are limited by email only.
TRUSTED_IP_HEADER=

# ── Mail (src/adapters/resend/mail.ts) ───────────────────────────────────────
# Only "resend" is implemented. Any other value throws.
MAIL_PROVIDER=resend

# Server-only: Resend API key. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Optional sender; must be on the domain verified in Resend.
# Defaults to AgarthaVision <no-reply@agarthavision.kazuretsu.dev>.
MAIL_FROM=

# Optional public origin for invitation links, e.g. the deployment's URL. When blank, the
# link uses the origin of the request that sent the invitation.
CONSOLE_URL=

# Optional. Each request logs how long the access check and each read took, as
# "[timing] db.listPeople 84ms" (names and milliseconds only). Set to "off" to silence.
CONSOLE_TIMING=
